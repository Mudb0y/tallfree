# Ghidra project: 42 MB and fully regenerable from firmware/ via the
# unpack + import steps in notes.md
work/ghidra_proj/

# The image and its boot loader, built by image/make_image.py
image/build/

# Build artefacts
work/**/*.o
work/**/*.elf
__pycache__/

# Decompressed firmware segments: regenerable by work/unpack.py
work/sdram_code.bin
work/itcm_code.bin
work/seg_*.bin
work/vectors.bin

# Decompiler dumps: regenerable with work/gscripts/DecompCallers.java
work/decomp/

# Engine builds and QEMU run leftovers
engine/build/
engine/out.raw
engine/in.txt
engine/rebuild.log

# Simulator outputs
engine/sim/*/sim.raw
engine/sim/*/sim_*.TXT
