# Private and never published: the working log and the unit's run logs, which
# only mean anything beside it; Roland's firmware, which is Roland's; this
# unit's flash and RAM dumps; and the decompiled Roland code Ghidra wrote.
notes.md
runs/
firmware/
dump/
ghidra/out/

# Roland's reference manual for the SP-404MK2, as text, which is Roland's
reference/

# Ghidra project, 43 MB: ghidra/import.sh rebuilds it from firmware/
ghidra/project/

# The regions Ghidra imports and the decompressed data: ghidra/unpack.py
ghidra/regions/

# Decompiler dumps: regenerable with ghidra/scripts/DecompCallers.java
ghidra/decomp/

# The image and its boot loader, built by image/make_image.py
image/build/

__pycache__/

# Engine builds and QEMU run leftovers
engine/build/
engine/out.raw
engine/in.txt
engine/rebuild.log

# Simulator outputs
engine/sim/*/sim.raw
engine/sim/*/sim_*.TXT

# The release zip, built by release/make_zip.py
release/build/
